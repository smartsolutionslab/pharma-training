<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SmartSolutionsLab.PharmaTraining.AppHost</RootNamespace>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <!-- Aspire keeps generated passwords here; without it a data volume outlives the password it was created with. -->
    <UserSecretsId>fabric-pharma-training-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <!-- Publish mode only (docs/adr/0005): the Container Apps environment, the Key Vault and the Flexible Server. -->
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
    <PackageReference Include="Aspire.Hosting.Azure.KeyVault" />
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" />
    <!-- Publish mode only: the auth proxy, the browser's one way to Keycloak (Wiring/AuthProxy.cs, docs/adr/0005). -->
    <PackageReference Include="Aspire.Hosting.Yarp" />
    <!-- A newer Container Apps model than Aspire's own, for the environment's peer traffic encryption (Wiring/ContainerAppsEnvironment.cs). -->
    <PackageReference Include="Azure.Provisioning.AppContainers" />
    <!-- Sets the emulator's CORS rule for the web app's origin (Wiring/BrowserUploads.cs). -->
    <PackageReference Include="Azure.Storage.Blobs" />
    <!-- Reads the modules' Application assemblies and the contracts as metadata, never loading them (Wiring/MessagingTopology.cs). -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MigrationRunner/MigrationRunner.csproj" />
    <ProjectReference Include="../Edge/Edge.csproj" />
    <!-- Run mode only: the demo data seeder (Wiring/DemoSeeding.cs, docs/adr/0042). -->
    <ProjectReference Include="../DemoSeeder/DemoSeeder.csproj" />
    <!-- Every service host, found by convention. Each gets a generated Projects.<Module>Service type, named after its folder
         (src/Services/<Module>/Host), so Aspire starts it from this build with dotnet run and no build of its own instead of building
         it again at every start (Wiring/ServiceHostProjects.cs). -->
    <ProjectReference Include="../Services/*/Host/Host.csproj" AspireProjectMetadataTypeName="$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName(%(FullPath)))))))Service" />
  </ItemGroup>

  <!-- Every module's Application and the contracts, built but neither referenced nor run: the broker grants each service's user
       the exchanges of the events its consumers take and of its own module's events, which Wiring/MessagingTopology.cs reads
       from these assemblies as metadata (docs/adr/0011). A new module's Application matches the glob; nothing lists one. -->
  <ItemGroup>
    <ProjectReference Include="../Modules/*/*.Application/*.Application.csproj;../Contracts/Contracts.csproj" ReferenceOutputAssembly="false" Private="false" IsAspireProjectResource="false" OutputItemType="MessagingAssembly" />
  </ItemGroup>

  <!-- Each built assembly's path, recorded on the AppHost's own assembly as AssemblyMetadata("MessagingAssembly", path). -->
  <Target Name="RecordMessagingAssemblies" DependsOnTargets="ResolveProjectReferences" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>MessagingAssembly</_Parameter1>
        <_Parameter2>%(MessagingAssembly.FullPath)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
