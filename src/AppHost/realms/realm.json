{
  "realm": "pharma-training",
  "enabled": true,
  "registrationAllowed": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@example.com",
    "fromDisplayName": "pharma-training",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      { "name": "manager", "description": "Sample role: each module's sample policy <module>.manage requires it." }
    ]
  },
  "clients": [
    {
      "clientId": "pharma-training-api",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "pharma-training-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "pharma-training-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "developer",
      "enabled": true,
      "email": "developer@example.com",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Developer",
      "credentials": [{ "type": "password", "value": "developer", "temporary": false }],
      "realmRoles": ["manager"]
    },
    {
      "username": "visitor",
      "enabled": true,
      "email": "visitor@example.com",
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Visitor",
      "credentials": [{ "type": "password", "value": "visitor", "temporary": false }]
    }
  ]
}
