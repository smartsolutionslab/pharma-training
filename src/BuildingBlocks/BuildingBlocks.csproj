<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartSolutionsLab.PharmaTraining.BuildingBlocks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <!-- Wolverine's message storage in a module's database, which the MigrationRunner builds and every service host uses
         through one configuration (Persistence/ModuleMessageStorage.cs). -->
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <ProjectReference Include="../Contracts/Contracts.csproj" />
    <PackageReference Include="Marten" />
    <!-- Signs short-lived upload and read URLs for a module's own blob container (src/BuildingBlocks/Storage); no module names it. -->
    <PackageReference Include="Azure.Storage.Blobs" />
    <!-- Published, a service signs and reads under its own managed identity: shared-key access is off (docs/adr/0002). -->
    <PackageReference Include="Azure.Identity" />
    <!-- Sends a module's plain-text mail over SMTP (src/BuildingBlocks/Mail); no module names it. -->
    <PackageReference Include="MailKit" />
    <InternalsVisibleTo Include="Mail.Tests" />
    <ProjectReference Include="../BuildingBlocks.EventSourcing/BuildingBlocks.EventSourcing.csproj" />
    <ProjectReference Include="../BuildingBlocks.Domain/BuildingBlocks.Domain.csproj" />
  </ItemGroup>

</Project>
