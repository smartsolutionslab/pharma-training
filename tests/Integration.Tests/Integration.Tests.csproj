<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartSolutionsLab.PharmaTraining.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" />
    <!-- The blob containers' resource types, read from the AppHost's model (AppHostBlobContainersTests). -->
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <!-- The publish-mode resource types (the Container Apps environment, Key Vault, the Flexible Server), read from the
         AppHost's publish model (PublishedAppHost). -->
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
    <PackageReference Include="Aspire.Hosting.Azure.KeyVault" />
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="RabbitMQ.Client" />
    <!-- A Wolverine host builds its message storage under a module's database role (ModuleDatabaseRoleTests). -->
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <!-- Compiles the probe consumers MessagingTopologyTests reads as a module's Application (ConsumerProbe). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Serializes the Wolverine envelope a forged scheduled-envelope wrapper carries (BrokerPublisherIntegrityTests). -->
    <PackageReference Include="WolverineFx" />
    <!-- Builds the PDFs with and without text that EditorialChapterFilesTests uploads (#157). -->
    <PackageReference Include="PdfPig" />
    <!-- FakeLogger: what a run waiting at the migration gate logs (SweptEventIndexTests, #351), and the warning
         EditorialRepublishLock logs when it cannot release the lock (EditorialRepublishTests). -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AppHost/AppHost.csproj" />
    <!-- AzureBlobUrls signs the URLs BlobStorageTests sends to the storage emulator. -->
    <ProjectReference Include="../../src/BuildingBlocks/BuildingBlocks.csproj" />
    <!-- EditorialRepublishTests takes the republish's lock through EditorialRepublishLock itself, on a pool of its own, to
         see a failed release leave nothing held. -->
    <ProjectReference Include="../../src/Modules/Editorial/Editorial.Infrastructure/Editorial.Infrastructure.csproj" />
    <!-- CertificationRetentionTests asks CertificateStore itself, with a keptAt of its own, whether PostgreSQL counts the
         five years around 29 February as Certificate.IsKeptByPharmaciesAt does (#53). -->
    <ProjectReference Include="../../src/Modules/Certification/Certification.Infrastructure/Certification.Infrastructure.csproj" />
  </ItemGroup>

</Project>
